# The brainCloud 6.0.0 pods require iOS 15.0 — target that or CocoaPods backtracks to 5.9.x.
platform :ios, '15.0'

target 'bcchat' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for bcchat
  pod 'ChameleonFramework/Swift', :git => 'https://github.com/wowansm/Chameleon.git', :branch => 'swift5'

  if ENV['PODSOURCE'].to_s.empty?
    if ENV['PODVERSION'].to_s.empty?
      pod 'BrainCloud'
    else
      pod 'BrainCloud', ENV['PODVERSION']
    end
  else
    pod 'BrainCloud', :path => ENV['PODSOURCE']
    pod 'BrainCloudCpp', :path => ENV['CPPSOURCE']
    pod 'BrainCloudJsonCpp', :path => ENV['JSONSOURCE']
  end
end


post_install do |installer|
    installer.generated_projects.each do |project|
          project.targets.each do |target|
              target.build_configurations.each do |config|
                  config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
               end
          end
   end

   # Xcode 26 clang enforces that angle-bracket includes only resolve system headers.
   # DefaultBrainCloudComms.h uses <braincloud/ServiceName.h> and <braincloud/ServiceOperation.h>
   # with angle brackets — patch to quotes so they resolve against the pod's include path.
   header = "#{installer.sandbox.root}/BrainCloudCpp/include/braincloud/internal/DefaultBrainCloudComms.h"
   if File.exist?(header)
     content = File.read(header)
     patched = content
       .gsub('#include <braincloud/ServiceName.h>', '#include "braincloud/ServiceName.h"')
       .gsub('#include <braincloud/ServiceOperation.h>', '#include "braincloud/ServiceOperation.h"')
     if patched != content
       begin
         # Published pods download read-only (mode 0444); make the header writable first.
         File.chmod(0644, header)
         File.write(header, patched)
         puts "Patched DefaultBrainCloudComms.h: angle-bracket includes → quoted includes"
       rescue => e
         puts "WARNING: could not patch DefaultBrainCloudComms.h (#{e.message}); continuing."
       end
     end
   end
end
